# Copy to .env and fill in. Used by the backend (export before `mvn spring-boot:run`) and set as Render env vars.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=pulsemedia-demo
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
